---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConstitutionalHero from '@/components/constitutional/ConstitutionalHero.astro';
import ConstitutionalQuietTransition from '@/components/constitutional/ConstitutionalQuietTransition.astro';
import CodexBookNavigator from '@/components/codex/CodexBookNavigator.astro';
import CodexFrontispiece from '@/components/codex/CodexFrontispiece.astro';
import CodexPlateInterlude from '@/components/codex/CodexPlateInterlude.astro';
import Book1 from '@/components/codex/books/Book1.astro';
import Book2 from '@/components/codex/books/Book2.astro';
import Book3 from '@/components/codex/books/Book3.astro';
import Book4 from '@/components/codex/books/Book4.astro';
import Book5 from '@/components/codex/books/Book5.astro';
import '@/styles/constitutional-library.css';
import '@/styles/codex-reading-system.css';

const plates = [
  { number: 'I', title: 'The Eternal City', src: '/images/codex/plate-1.jpg', alt: 'Ancient Roman path' },
  { number: 'II', title: 'The Romanisti', src: '/images/codex/plate-2.jpg', alt: 'Sidewalk table, chair, scarf, and espresso' },
  { number: 'III', title: 'The Publication', src: '/images/codex/plate-3.jpg', alt: 'Roman nasone fountain' },
  { number: 'IV', title: 'Rome and AS Roma', src: '/images/codex/plate-4.jpg', alt: 'SPQR manhole cover' },
  { number: 'V', title: 'Among Romans', src: '/images/codex/plate-5.jpg', alt: 'Roman steps' },
];
---

<BaseLayout
  title="Codex I — De Aeternitate"
  description="The canonical manuscript of Codex I — De Aeternitate."
  type="article"
>
  <article class="codex-reading-system">
    <ConstitutionalHero
      libraryMark="Romanisti · Constitutional Library"
      edition="Edition One"
      workClass="Philosophical Work"
      title="Codex I — De Aeternitate"
      subtitle="Five Books on Endurance, Stewardship, and Rome"
      quotation="The philosophical foundation of Romanisti."
      enterLabel="Open the Codex"
      enterHref="#contents"
    />

    <CodexBookNavigator />

    <ConstitutionalQuietTransition text="The work begins with Rome." />

    <section class="codex-book">
      <CodexFrontispiece id="book-1" number="I" title="The Eternal City" />
      <div class="codex-book-manuscript"><Book1 /></div>
      <CodexPlateInterlude {...plates[0]} />
    </section>

    <section class="codex-book">
      <CodexFrontispiece id="book-2" number="II" title="The Romanisti" />
      <div class="codex-book-manuscript"><Book2 /></div>
      <CodexPlateInterlude {...plates[1]} />
    </section>

    <section class="codex-book">
      <CodexFrontispiece id="book-3" number="III" title="The Publication" />
      <div class="codex-book-manuscript"><Book3 /></div>
      <CodexPlateInterlude {...plates[2]} />
    </section>

    <section class="codex-book">
      <CodexFrontispiece id="book-4" number="IV" title="Rome and AS Roma" />
      <div class="codex-book-manuscript"><Book4 /></div>
      <CodexPlateInterlude {...plates[3]} />
    </section>

    <section class="codex-book">
      <CodexFrontispiece id="book-5" number="V" title="Among Romans" />
      <div class="codex-book-manuscript"><Book5 /></div>
      <CodexPlateInterlude {...plates[4]} />
    </section>

    <ConstitutionalQuietTransition text="Perhaps it is enough." />

    <section class="codex-completion">
      <div class="codex-completion__inner">
        <p>Codex I is complete</p>

        <nav class="codex-completion__primary" aria-label="Codex I return destinations">
          <a href="/library/foundation/">Foundation</a>
          <span aria-hidden="true">·</span>
          <a href="/works/">Works Room</a>
        </nav>

        <a class="codex-completion__secondary" href="/#bibliotheca">
          Return to Bibliotheca
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
