---
import ArchitecturalLayout from '@/layouts/ArchitecturalLayout.astro';
import { institutionalRoutes as routes } from '@/config/institutionalRoutes';

const objects = [
  {
    label: 'Project Aurea',
    href: routes.projectAurea,
    className: 'project-aurea',
  },
  {
    label: 'Liber Constitutionis',
    href: routes.liberConstitutionis,
    className: 'constitutionis',
  },
  {
    label: 'Liber Lapidum',
    href: routes.liberLapidum,
    className: 'lapidum',
  },
  {
    label: 'Liber Conventus',
    href: routes.liberConventus,
    className: 'conventus',
  },
  {
    label: 'Codex I — De Aeternitate',
    href: routes.codexI,
    className: 'codex',
  },
];
---

<ArchitecturalLayout title="Foundation | Romanisti">
  <main class="foundation-wing">
    <section class="foundation-room" aria-labelledby="foundation-title">
      <h1 id="foundation-title" class="visually-hidden">Foundation</h1>

      <img
        src="/images/bibliotheca/canonical/foundation-room-architectural-plate-v1.webp"
        alt="The Foundation Room of the Bibliotheca, preserving Project Aurea, Liber Constitutionis, Liber Lapidum, Liber Conventus, the North Star, and Codex I — De Aeternitate."
        width="1536"
        height="1024"
        decoding="async"
      />

      <nav class="foundation-object-navigation" aria-label="Foundation works">
        {objects.map((object) => (
          <a
            class={`foundation-object ${object.className}`}
            href={object.href}
            aria-label={`Open ${object.label}`}
          >
            <span>{object.label}</span>
          </a>
        ))}
      </nav>

      <div class="foundation-mobile-nav" data-foundation-mobile-nav>
        <button
          class="foundation-mobile-trigger"
          type="button"
          aria-label="Open Foundation documents"
          aria-expanded="false"
          aria-controls="foundation-mobile-panel"
          data-foundation-mobile-open
        >
          <span class="visually-hidden">Foundation documents</span>
        </button>

        <div
          id="foundation-mobile-panel"
          class="foundation-mobile-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="foundation-mobile-title"
          hidden
          data-foundation-mobile-panel
        >
          <div class="foundation-mobile-panel__header">
            <div>
              <p class="foundation-mobile-panel__eyebrow">Permanent Documents</p>
              <h2 id="foundation-mobile-title">Foundation</h2>
            </div>
            <button
              class="foundation-mobile-panel__close"
              type="button"
              aria-label="Close Foundation documents"
              data-foundation-mobile-close
            >×</button>
          </div>

          <nav class="foundation-mobile-panel__links" aria-label="Foundation documents">
            <a href={routes.projectAurea}>Project Aurea</a>
            <a href={routes.liberConstitutionis}>Liber Constitutionis</a>
            <a href={routes.liberLapidum}>Liber Lapidum</a>
            <a href={routes.liberConventus}>Liber Conventus</a>
          </nav>
        </div>
      </div>
    </section>

    <nav class="foundation-actions" aria-label="Foundation room navigation">
      <a href={routes.bibliotheca}>Return to the Bibliotheca</a>
    </nav>
  </main>
</ArchitecturalLayout>

<script>
  const foundationMobileNav = document.querySelector('[data-foundation-mobile-nav]');

  if (foundationMobileNav) {
    const openButton = foundationMobileNav.querySelector('[data-foundation-mobile-open]');
    const closeButton = foundationMobileNav.querySelector('[data-foundation-mobile-close]');
    const panel = foundationMobileNav.querySelector('[data-foundation-mobile-panel]');

    const openPanel = () => {
      if (!(openButton instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
      panel.hidden = false;
      openButton.setAttribute('aria-expanded', 'true');
      if (closeButton instanceof HTMLButtonElement) closeButton.focus();
    };

    const closePanel = () => {
      if (!(openButton instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
      panel.hidden = true;
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    };

    openButton?.addEventListener('click', openPanel);
    closeButton?.addEventListener('click', closePanel);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel instanceof HTMLElement && !panel.hidden) closePanel();
    });
  }
</script>

<style is:global>
  body {
    background: #17120d;
  }

  .foundation-wing {
    width: 100%;
    background: #17120d;
  }

  .foundation-room {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: #17120d;
  }

  .foundation-room > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 52%;
  }

  .foundation-object-navigation {
    position: absolute;
    z-index: 2;
    inset: 0;
  }

  .foundation-object {
    position: absolute;
    display: block;
    border-radius: 0.2rem;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .foundation-object::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    transition: border-color 180ms ease;
  }

  .foundation-object span {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 92%;
    padding: 0.28rem 0.5rem;
    color: rgb(74 52 37 / 0%);
    background: rgb(244 236 221 / 0%);
    font-size: clamp(0.48rem, 0.65vw, 0.7rem);
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .foundation-object:hover,
  .foundation-object:focus-visible {
    background: rgb(255 244 219 / 7%);
    box-shadow:
      inset 0 0 2rem rgb(255 232 183 / 13%),
      0 0 1.4rem rgb(94 60 26 / 10%);
    filter: brightness(1.035);
    outline: none;
  }

  .foundation-object:hover::after,
  .foundation-object:focus-visible::after {
    border-color: rgb(184 131 62 / 28%);
  }

  .foundation-object:hover span,
  .foundation-object:focus-visible span {
    color: rgb(74 52 37 / 92%);
    background: rgb(244 236 221 / 76%);
  }

  .foundation-object:focus-visible {
    outline: 2px solid #b68447;
    outline-offset: 4px;
  }

  /* Hotspots mapped to the locked architectural plate. */
  .project-aurea {
    left: 3.0%;
    top: 25.5%;
    width: 15.2%;
    height: 31%;
  }

  .constitutionis {
    left: 21.2%;
    top: 25.5%;
    width: 16.3%;
    height: 31%;
  }

  .lapidum {
    left: 62.4%;
    top: 25.5%;
    width: 16.2%;
    height: 31%;
  }

  .conventus {
    left: 81.2%;
    top: 25.5%;
    width: 15.0%;
    height: 31%;
  }

  .codex {
    left: 42.2%;
    top: 52.5%;
    width: 15.6%;
    height: 30.5%;
  }

  .foundation-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    min-height: 3.75rem;
    padding: 0.85rem clamp(1.25rem, 4vw, 4rem);
    background: #f3ede2;
    border-top: 1px solid rgb(117 88 52 / 24%);
  }

  .foundation-actions a {
    color: #4a3425;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .foundation-actions a:hover,
  .foundation-actions a:focus-visible {
    color: #8f1f2c;
    text-decoration: underline;
    text-underline-offset: 0.28rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Foundation Mobile RC1 — preserve the centered plate and Codex hotspot.
     The four off-crop Foundation destinations move behind the SPQR medallion
     only at the established Institution mobile breakpoint. */
  .foundation-mobile-nav {
    display: none;
  }

  @media (max-width: 52rem) {
    .foundation-room {
      min-height: 100svh;
    }

    .foundation-room > img {
      object-position: 50% 50%;
    }

    .foundation-object span {
      display: none;
    }

    /* Remove off-crop focus targets on mobile; Codex remains a direct link. */
    .foundation-object.project-aurea,
    .foundation-object.constitutionis,
    .foundation-object.lapidum,
    .foundation-object.conventus {
      display: none;
    }

    .foundation-mobile-nav {
      display: block;
      position: absolute;
      z-index: 4;
      inset: 0;
      pointer-events: none;
    }

    /* The visible SPQR floor medallion becomes the mobile-only document index. */
    .foundation-mobile-trigger {
      position: absolute;
      left: 50%;
      top: 88%;
      width: min(8.5rem, 38vw);
      height: min(6.25rem, 13svh);
      transform: translate(-50%, -50%);
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
      pointer-events: auto;
      -webkit-tap-highlight-color: transparent;
    }

    .foundation-mobile-trigger:focus-visible {
      outline: 2px solid #b68447;
      outline-offset: 3px;
    }

    .foundation-mobile-panel {
      position: absolute;
      z-index: 6;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 72svh;
      overflow-y: auto;
      color: #efe0cd;
      background: rgb(24 17 12 / 97%);
      border-top: 1px solid rgb(182 132 71 / 54%);
      box-shadow: 0 -1.25rem 3rem rgb(0 0 0 / 38%);
      pointer-events: auto;
    }

    .foundation-mobile-panel[hidden] {
      display: none;
    }

    .foundation-mobile-panel__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1rem 0.9rem;
      border-bottom: 1px solid rgb(182 132 71 / 28%);
    }

    .foundation-mobile-panel__eyebrow {
      margin: 0 0 0.28rem;
      color: #c99652;
      font-family: var(--font-sans, Arial, sans-serif);
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .foundation-mobile-panel h2 {
      margin: 0;
      color: #f4eadc;
      font-family: var(--font-display, Georgia, serif);
      font-size: clamp(1.65rem, 8vw, 2.15rem);
      font-weight: 400;
      line-height: 1;
    }

    .foundation-mobile-panel__close {
      display: grid;
      place-items: center;
      width: 2.15rem;
      height: 2.15rem;
      flex: 0 0 auto;
      padding: 0;
      color: #f0dfc8;
      background: transparent;
      border: 1px solid rgb(182 132 71 / 58%);
      border-radius: 50%;
      font: 400 1.2rem/1 Georgia, serif;
      cursor: pointer;
    }

    .foundation-mobile-panel__links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      padding: 0.85rem 1rem max(1rem, env(safe-area-inset-bottom));
    }

    .foundation-mobile-panel__links a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 3rem;
      padding: 0.65rem 0.5rem;
      color: #edcf9a;
      background: rgb(255 255 255 / 1.5%);
      border: 1px solid rgb(182 132 71 / 34%);
      font-family: var(--font-sans, Arial, sans-serif);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.25;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
    }

    .foundation-mobile-panel__links a:focus-visible {
      outline: 2px solid #b68447;
      outline-offset: 2px;
    }

    .foundation-actions {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.65rem;
      min-height: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foundation-object,
    .foundation-object::after,
    .foundation-object span {
      transition: none;
    }
  }
</style>
