---
import { primaryNavigation } from '@/config/navigation';
import { site } from '@/config/site';

const currentPath = Astro.url.pathname;
const isThreshold = currentPath === '/';
const isItalian = currentPath === '/it' || currentPath.startsWith('/it/');
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class:list={['site-header', { 'site-header--threshold': isThreshold }]} data-site-header>
  <div class="container header-inner">
    <a class="identity" href="/" aria-label={`${site.name} home`}>
      <span>{site.name}</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {primaryNavigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="language-utility" aria-label="Language selection">
          <a class:list={{ active: !isItalian }} href="/" lang="en" aria-current={!isItalian ? 'page' : undefined}>EN</a>
          <span aria-hidden="true">|</span>
          <a class:list={{ active: isItalian }} href="/it/" lang="it" aria-current={isItalian ? 'page' : undefined}>IT</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

{isThreshold && (
  <script is:inline>
    (() => {
      const initialiseHeaderMaterialState = () => {
        const header = document.querySelector('[data-site-header]');
        const threshold = document.querySelector('.threshold');

        if (!(header instanceof HTMLElement) || !(threshold instanceof HTMLElement)) return;

        let frame = 0;

        const setMaterialState = (isMaterial) => {
          header.classList.toggle('is-material', isMaterial);
          header.setAttribute('data-material-state', isMaterial ? 'reading-room' : 'threshold');
        };

        const updateMaterialState = () => {
          frame = 0;
          const headerHeight = Math.ceil(header.getBoundingClientRect().height);
          const thresholdBottom = threshold.getBoundingClientRect().bottom;
          setMaterialState(thresholdBottom <= headerHeight - 100);
        };

        const requestUpdate = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(updateMaterialState);
        };

        updateMaterialState();
        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate, { passive: true });
        window.addEventListener('pageshow', requestUpdate);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initialiseHeaderMaterialState, { once: true });
      } else {
        initialiseHeaderMaterialState();
      }
    })();
  </script>
)}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--color-ink);
    background: rgb(244 240 232 / 88%);
    border-bottom: 0;
  }

  .site-header--threshold {
    position: fixed;
    inset: 0 0 auto;
    width: 100%;
    color: #e7ddca;
    background-color: transparent;
    background-image: linear-gradient(180deg, rgb(4 3 2 / 42%) 0%, transparent 100%);
    border-bottom: 0;
    transition:
      color 420ms ease,
      background-color 560ms ease,
      color 560ms ease;
  }

  .site-header--threshold.is-material {
    color: #68635b;
    background-color: transparent;
    background-image: none;
    border-bottom: 0;
    box-shadow: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.75rem;
  }

  .identity {
    color: inherit;
    font-family: var(--font-display);
    text-decoration: none;
  }

  .identity span {
    font-size: 1.35rem;
    letter-spacing: 0.035em;
  }

  .site-header--threshold .identity {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header--threshold .header-inner {
    justify-content: flex-end;
    min-height: 5.25rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.1rem, 2.15vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: color 420ms ease;
  }

  .site-header--threshold nav a {
    color: rgb(231 221 202 / 66%);
    font-size: 0.69rem;
    font-weight: 500;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    text-shadow: 0 1px 0.5rem rgb(0 0 0 / 36%);
  }

  .site-header--threshold.is-material nav ul > li:not(.language-utility) > a {
    color: #68635b !important;
    text-shadow:
      0 1px 0 rgb(255 250 241 / 18%),
      0 0 0.55rem rgb(255 250 241 / 10%) !important;
  }

  .language-utility {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    margin-left: clamp(0.75rem, 1.4vw, 1.35rem);
    white-space: nowrap;
  }

  .language-utility span {
    color: rgb(91 64 38 / 34%);
    font-family: var(--font-sans);
    font-size: 0.66rem;
  }

  .site-header--threshold .language-utility span {
    color: rgb(231 221 202 / 34%);
    transition: color 420ms ease;
  }

  .site-header--threshold .language-utility a {
    color: rgb(231 221 202 / 43%);
  }

  .site-header--threshold.is-material .language-utility > span {
    color: rgb(104 99 91 / 58%) !important;
  }

  .site-header--threshold.is-material .language-utility > a {
    color: rgb(104 99 91 / 88%) !important;
    text-shadow:
      0 1px 0 rgb(255 250 241 / 16%),
      0 0 0.5rem rgb(255 250 241 / 8%) !important;
  }

  .site-header--threshold .language-utility a.active,
  .site-header--threshold .language-utility a:hover,
  .site-header--threshold .language-utility a:focus-visible {
    color: rgb(231 221 202 / 96%);
  }

  .site-header--threshold.is-material .language-utility > a.active,
  .site-header--threshold.is-material .language-utility > a:hover,
  .site-header--threshold.is-material .language-utility > a:focus-visible {
    color: #b58b36 !important;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .site-header--threshold nav a:hover,
  .site-header--threshold nav a:focus-visible,
  .site-header--threshold nav a[aria-current='page'] {
    color: rgb(231 221 202 / 96%);
  }

  .site-header--threshold.is-material nav ul > li:not(.language-utility) > a:hover,
  .site-header--threshold.is-material nav ul > li:not(.language-utility) > a:focus-visible,
  .site-header--threshold.is-material nav ul > li:not(.language-utility) > a[aria-current='page'] {
    color: #3f3b35 !important;
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.38em;
  }

  .site-header--threshold nav a[aria-current='page'] {
    text-decoration: none;
  }

  @supports (backdrop-filter: blur(1rem)) {
    .site-header:not(.site-header--threshold) {
      backdrop-filter: blur(1rem);
    }

    .site-header:not(.site-header--threshold) {
      background: rgb(244 240 232 / 76%);
    }

    .site-header--threshold.is-material {
      background-color: transparent;
      background-image: none;
    }
  }

  @media (max-width: 52rem) {
    .site-header--threshold .header-inner {
      min-height: 4.75rem;
    }

    .site-header--threshold nav a {
      font-size: 0.65rem;
    }
  }

  @media (max-width: 42rem) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      padding-block: var(--space-3);
    }

    .site-header--threshold .header-inner {
      align-items: center;
      flex-direction: row;
      min-height: 4.5rem;
      padding-block: 0;
    }

    .site-header--threshold nav {
      display: none;
    }

    ul {
      gap: 0.75rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header--threshold,
    nav a,
    .site-header--threshold .language-utility span {
      transition: none;
    }
  }
</style>
