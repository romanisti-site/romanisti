    transform: translateX(-50%);
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(96 72 45 / 7%), transparent 7%, transparent 93%, rgb(96 72 45 / 7%)),
      linear-gradient(180deg, rgb(255 253 243 / 18%), transparent 18%, transparent 82%, rgb(89 65 39 / 6%));
    box-shadow:
      inset 1.1rem 0 1.8rem -1.7rem rgb(70 50 30 / 42%),
      inset -1.1rem 0 1.8rem -1.7rem rgb(70 50 30 / 42%),
      inset 0 1.1rem 1.8rem -1.7rem rgb(70 50 30 / 30%);
    opacity: 0.82;
  }

  .reading-room-shell__light-source {
    position: absolute;
    top: clamp(2.25rem, 4vh, 4rem);
    left: 50%;
    width: min(70rem, 86vw);
    height: 78%;
    transform: translateX(-50%);
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 26%, rgb(255 249 225 / 55%) 0%, rgb(255 246 216 / 30%) 23%, rgb(255 245 219 / 12%) 46%, transparent 72%),
      linear-gradient(180deg, rgb(255 251 236 / 13%), transparent 68%);
