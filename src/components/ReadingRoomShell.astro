      #c2b197;
    box-shadow: inset 0 1px rgb(255 255 255 / 16%);
  }

  .reading-room-shell__floor::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 0%, rgb(255 247 224 / 12%), transparent 60%);
  }

  @media (max-width: 52rem) {
