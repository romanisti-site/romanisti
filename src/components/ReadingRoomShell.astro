<section class="reading-room-shell" aria-label="The Reading Room">
  <div class="reading-room-shell__arrival" aria-hidden="true"></div>
  <div class="reading-room-shell__wall" aria-hidden="true">
    <div class="reading-room-shell__light-source"></div>
  </div>
  <div class="reading-room-shell__floor" aria-hidden="true"></div>
</section>

<style>
  .reading-room-shell {
    --arrival-depth: clamp(9rem, 18vh, 14rem);
    position: relative;
    isolation: isolate;
    min-height: clamp(44rem, 88svh, 64rem);
    overflow: hidden;
    background: #d4c8b5;
  }

  /* The Threshold dissipates into the room; there is no section edge. */
  .reading-room-shell__arrival {
    position: absolute;
    inset: 0 0 auto;
    z-index: 7;
    height: var(--arrival-depth);
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        #090705 0%,
        rgb(20 16 11 / 96%) 12%,
        rgb(55 45 33 / 76%) 36%,
        rgb(126 108 83 / 38%) 64%,
        rgb(216 205 187 / 0%) 100%
      );
  }

  .reading-room-shell::before {
    content: '';
    position: absolute;
    inset: var(--arrival-depth) 0 0;
    z-index: 6;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 34%, transparent 42%, rgb(63 49 34 / 8%) 100%),
      linear-gradient(90deg, rgb(57 42 28 / 4%), transparent 13%, transparent 87%, rgb(57 42 28 / 4%));
  }

  .reading-room-shell__wall {
    position: absolute;
    inset: calc(var(--arrival-depth) - 1px) 0 24%;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(91 69 45 / 5%) 1px, transparent 1px) 0 0 / clamp(11rem, 18vw, 18rem) 100%,
      linear-gradient(180deg, rgb(255 255 255 / 12%), transparent 24%, rgb(91 68 43 / 5%)),
      #d8cdbb;
    box-shadow:
      inset 0 -2rem 3.8rem rgb(70 52 34 / 8%),
      inset 0 1px rgb(255 255 255 / 20%);
  }

  /* Quiet stone variation, not a decorative texture. */
  .reading-room-shell__wall::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.24;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 18% 24%, rgb(255 255 255 / 24%) 0 1px, transparent 1.6px),
      radial-gradient(circle at 72% 46%, rgb(76 55 34 / 10%) 0 1px, transparent 1.7px),
      radial-gradient(circle at 48% 78%, rgb(255 255 255 / 13%) 0 1px, transparent 1.5px);
    background-size: 10rem 8rem, 13rem 11rem, 9rem 12rem;
    mix-blend-mode: soft-light;
  }

  /*
   * The opening is inferred rather than drawn. A shallow change in wall plane,
   * slight occlusion, and daylight bloom imply an aperture beyond the surface.
   */
  .reading-room-shell__wall::after {
    content: '';
    position: absolute;
    top: clamp(3.5rem, 7vh, 6rem);
    left: 50%;
    width: clamp(18rem, 34vw, 34rem);
