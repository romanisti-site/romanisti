      "The place remained.": "Il luogo rimase.",
      "Not as it was.": "Non com’era.",
      "As something carried.": "Come qualcosa da portare con sé.",
      "Romanisti can feel the loss of a ground they never entered. They are not remembering their own experience. They are recognizing an inheritance.": "I romanisti possono sentire la perdita di un campo in cui non sono mai entrati. Non stanno ricordando una propria esperienza. Stanno riconoscendo un’eredità.",
      "Home does not always mean where you are.": "Casa non significa sempre dove ti trovi.",
      "Sometimes it means where you learned who you were.": "A volte significa dove hai imparato chi eri.",
      "For Roma, one of those places is still in Testaccio.": "Per la Roma, uno di quei luoghi è ancora a Testaccio.",
      "You can go there.": "Puoi andarci.",
      "There is remarkably little to see.": "C’è sorprendentemente poco da vedere.",
      "That may be the point.": "Forse è proprio questo il punto.",
      "Buildings disappear. Generations disappear. Football grounds disappear.": "Gli edifici scompaiono. Le generazioni scompaiono. I campi di calcio scompaiono.",
      "Place is more stubborn.": "Il luogo è più ostinato.",

    };

    const originals = new WeakMap();
    const attrOriginals = new WeakMap();
    const translatedAttributes = ['aria-label', 'placeholder', 'title'];

    const getLanguage = () => {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        return VALID.has(stored) ? stored : 'en';
      } catch {
        return 'en';
      }
    };

    const rememberAttribute = (element, attribute) => {
      let values = attrOriginals.get(element);
      if (!values) {
        values = {};
        attrOriginals.set(element, values);
      }
      if (!(attribute in values)) values[attribute] = element.getAttribute(attribute);
      return values[attribute];
    };

    const translateTextNode = (node, language) => {
      if (!originals.has(node)) originals.set(node, node.nodeValue ?? '');
      const original = originals.get(node) ?? '';
      if (language === 'en') {
        if (node.nodeValue !== original) node.nodeValue = original;
        return;
      }

      const trimmed = original.trim();
      if (!trimmed) return;
      const normalized = trimmed.replace(/\s+/g, ' ');
      const leading = original.match(/^\s*/)?.[0] ?? '';
      const trailing = original.match(/\s*$/)?.[0] ?? '';

      // Dates are dynamic content, so localize any semantic <time datetime="..."> element
      // instead of maintaining one translation entry per publication date.
      const parent = node.parentElement;
      if (parent?.tagName === 'TIME' && parent.hasAttribute('datetime')) {
        const date = new Date(parent.getAttribute('datetime'));
        if (!Number.isNaN(date.getTime())) {
          const localized = new Intl.DateTimeFormat('it-IT', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          }).format(date);
          node.nodeValue = `${leading}${localized}${trailing}`;
          return;
        }
      }

      if (normalized in translations) {
        node.nodeValue = `${leading}${translations[normalized]}${trailing}`;
        return;
      }

      const resultMatch = normalized.match(/^(\d+) results?\.$/);
      if (resultMatch) {
        const count = Number(resultMatch[1]);
        node.nodeValue = `${leading}${count} ${count === 1 ? 'risultato' : 'risultati'}.${trailing}`;
        return;
      }

      // Archive counts are dynamic. Localize them generically so future years
      // do not require one translation entry per count.
      const workCountMatch = normalized.match(/^(\d+) works?$/);
      if (workCountMatch) {
        const count = Number(workCountMatch[1]);
        node.nodeValue = `${leading}${count} ${count === 1 ? 'opera' : 'opere'}${trailing}`;
      }
    };

    const translateElementAttributes = (element, language) => {
      for (const attribute of translatedAttributes) {
        if (!element.hasAttribute(attribute)) continue;
        const original = rememberAttribute(element, attribute);
        if (original == null) continue;
        if (language === 'en') {
          if (element.getAttribute(attribute) !== original) element.setAttribute(attribute, original);
        } else if (original in translations) {
          element.setAttribute(attribute, translations[original]);
        }
      }
    };

    const translateSubtree = (root, language) => {
      if (root.nodeType === Node.TEXT_NODE) {
        translateTextNode(root, language);
        return;
      }
      if (!(root instanceof Element) && !(root instanceof Document)) return;

      if (root instanceof Element) translateElementAttributes(root, language);

      const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
      let node = walker.nextNode();
      while (node) {
        if (node.nodeType === Node.TEXT_NODE) translateTextNode(node, language);
        else if (node instanceof Element) translateElementAttributes(node, language);
        node = walker.nextNode();
      }
    };

    const syncToggles = (language) => {
      document.querySelectorAll('[data-language-toggle]').forEach((control) => {
        const target = control.getAttribute('data-language-toggle');
        const active = target === language;
        control.classList.toggle('active', active);
        if (active) control.setAttribute('aria-current', 'page');
        else control.removeAttribute('aria-current');
      });
    };

    const applyLanguage = (language) => {
      if (!VALID.has(language)) language = 'en';
      document.documentElement.lang = language;
      document.documentElement.dataset.language = language;
      translateSubtree(document.body, language);
      syncToggles(language);
      window.dispatchEvent(new CustomEvent('romanisti:languagechange', { detail: { language } }));
    };

    const setLanguage = (language) => {
      if (!VALID.has(language)) return;
      try { localStorage.setItem(STORAGE_KEY, language); } catch {}
      applyLanguage(language);
    };

    const initialise = () => {
      let language = getLanguage();
      applyLanguage(language);

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-language-toggle]') : null;
        if (!target) return;
        const requested = target.getAttribute('data-language-toggle');
        if (!VALID.has(requested)) return;
        event.preventDefault();
        language = requested;
        setLanguage(language);
      });

      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          mutation.addedNodes.forEach((node) => translateSubtree(node, language));
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialise, { once: true });
    } else {
      initialise();
    }
  })();
</script>
