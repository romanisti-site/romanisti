---
import type { CollectionEntry } from 'astro:content';
import Liber from './Liber.astro';

interface Props {
  entries: CollectionEntry<'observations'>[];
}

const { entries } = Astro.props;
const positions = Array.from({ length: 5 }, (_, index) => entries[index]);
---
<div class="librarian-table" aria-label="The five newest Libri">
  <div class="libri-row">
    {positions.map((entry, index) => <Liber entry={entry} position={index + 1} />)}
  </div>
  <div class="marble-slab" aria-hidden="true"></div>
  <div class="table-carcass" aria-hidden="true">
    <span class="apron"></span>
    <span class="leg leg--left"></span>
    <span class="leg leg--right"></span>
    <span class="stretcher"></span>
  </div>
</div>

<style>
  .librarian-table {
    position: relative;
    z-index: 4;
    width: min(100%, 94rem);
    margin: clamp(3.4rem, 7vh, 6rem) auto 0;
    padding-inline: clamp(0.6rem, 1.6vw, 1.5rem);
  }

  .libri-row {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.7rem, 1.05vw, 1.05rem);
    align-items: end;
    width: min(76%, 70rem);
    padding: 0 clamp(0.35rem, 0.8vw, 0.8rem) 0.2rem;
  }

  .marble-slab {
    position: relative;
    z-index: 3;
    height: clamp(2.9rem, 4vw, 4rem);
    border: 1px solid rgb(94 70 46 / 38%);
    border-radius: 0.18rem 0.18rem 0.3rem 0.3rem;
    background:
      linear-gradient(103deg, transparent 0 12%, rgb(106 83 62 / 12%) 12.3% 12.55%, transparent 12.8% 38%, rgb(117 91 68 / 9%) 38.2% 38.5%, transparent 38.8% 71%, rgb(102 77 55 / 12%) 71.2% 71.45%, transparent 71.8%),
      linear-gradient(180deg, #e7dcc9 0%, #cdbda6 52%, #ad997f 100%);
    box-shadow:
      0 1.35rem 1.8rem rgb(35 22 12 / 22%),
      inset 0 1px rgb(255 255 255 / 75%),
      inset 0 -0.35rem rgb(78 56 38 / 10%);
  }

  .marble-slab::before {
    content: '';
    position: absolute;
    inset: 0.35rem 1.2rem auto;
    height: 1px;
    background: rgb(255 255 255 / 38%);
  }

  .table-carcass {
    position: relative;
    z-index: 2;
    width: 91%;
    height: clamp(7.5rem, 10vw, 10.5rem);
    margin-inline: auto;
    color: #302015;
    filter: drop-shadow(0 1.4rem 1.4rem rgb(25 15 8 / 20%));
  }

  .apron {
    position: absolute;
    inset: 0 2.5% auto;
    height: 40%;
    border: 1px solid rgb(22 12 6 / 65%);
    background:
      linear-gradient(90deg, rgb(255 255 255 / 4%), transparent 14% 86%, rgb(0 0 0 / 13%)),
      linear-gradient(180deg, #4d3321 0%, #2d1d13 72%, #20130d 100%);
    box-shadow: inset 0 0.45rem 0.7rem rgb(255 255 255 / 4%), inset 0 -0.4rem rgb(0 0 0 / 17%);
  }

  .apron::after {
    content: '';
    position: absolute;
    inset: 22% 8%;
    border: 1px solid rgb(167 125 76 / 16%);
    box-shadow: inset 0 0 0 0.35rem rgb(0 0 0 / 8%);
  }

  .leg {
    position: absolute;
    top: 24%;
    bottom: 0;
    width: 10.5%;
    border: 1px solid rgb(22 12 6 / 65%);
    background:
      repeating-linear-gradient(90deg, transparent 0 20%, rgb(180 135 82 / 9%) 21% 24%, transparent 25% 40%),
      linear-gradient(90deg, #24160f, #4b3020 48%, #21140d);
  }

  .leg::before,
  .leg::after {
    content: '';
    position: absolute;
    left: 11%; right: 11%;
    height: 12%;
    border-block: 1px solid rgb(176 129 78 / 18%);
    background: rgb(0 0 0 / 8%);
  }

  .leg::before { top: 14%; }
  .leg::after { bottom: 10%; }
  .leg--left { left: 5%; }
  .leg--right { right: 5%; }

  .stretcher {
    position: absolute;
    left: 13%; right: 13%;
    bottom: 19%;
    height: 12%;
    border: 1px solid rgb(22 12 6 / 60%);
    background: linear-gradient(180deg, #4a3020, #21140d);
  }

  @media (max-width: 64rem) {
    .libri-row {
      grid-template-columns: repeat(5, minmax(12.5rem, 1fr));
      width: calc(100% - 2rem);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      padding-bottom: 0.4rem;
    }
    .libri-row > * { scroll-snap-align: start; }
  }

  @media (max-width: 42rem) {
    .librarian-table { padding-inline: 0; }
    .libri-row { width: 100%; grid-template-columns: repeat(5, minmax(72vw, 1fr)); padding-inline: 1rem; }
    .marble-slab { border-radius: 0; }
    .table-carcass { width: 96%; }
  }
</style>
