---
import plate from '../../assets/archive-room/mobile/archive-room-mobile-plate-rc2.png';
import { getObservationArchive } from '@/lib/archive';
import { getTopics } from '@/lib/topics';

const archiveGroups = await getObservationArchive();
const years = archiveGroups.slice(0, 6).map((group) => ({
  year: group.year,
  count: group.entries.length,
}));

const topics = (await getTopics())
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label))
  .slice(0, 8);
---

<section class="mobile-archive-room" aria-label="The Archive Room">
  <div class="mobile-archive-room__scene">
    <div class="mobile-archive-room__canvas">
      <img
        class="mobile-archive-room__plate"
        src={plate.src}
        width={plate.width}
        height={plate.height}
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <div class="mobile-archive-room__overlay" data-mobile-archive-overlay>
        <button
          class="mobile-archive-hit mobile-archive-hit--catalog"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-archive-catalog-panel"
          data-mobile-catalog-trigger
        >
          <span class="mobile-archive-hit__label">Archive Catalog</span>
        </button>

        <a
          class="mobile-archive-hit mobile-archive-hit--observation"
          href="/observations/archive/"
          aria-label="Observation Archive"
        >
          <span class="mobile-archive-hit__label">Observation Archive</span>
        </a>

        <a
          class="mobile-archive-hit mobile-archive-hit--collections"
          href="/special-editions/"
          aria-label="Collections"
        >
          <span class="mobile-archive-hit__label">Collections</span>
        </a>

        <a
          class="mobile-archive-hit mobile-archive-hit--works"
          href="/works/"
          aria-label="Works Room"
        >
          <span class="mobile-archive-hit__label">Works Room</span>
        </a>

        <section
          class="mobile-catalog-panel"
          id="mobile-archive-catalog-panel"
          aria-labelledby="mobile-archive-catalog-heading"
          aria-hidden="true"
          data-mobile-catalog-panel
        >
          <div class="mobile-catalog-panel__header">
            <div>
              <p class="mobile-catalog-panel__eyebrow">The permanent record of published work</p>
              <h2 id="mobile-archive-catalog-heading">Archive Catalog</h2>
            </div>
            <button class="mobile-catalog-panel__close" type="button" aria-label="Close archive catalog" data-mobile-catalog-close>
              <span aria-hidden="true">×</span>
            </button>
          </div>

          <div class="mobile-catalog-panel__body">
            <form class="mobile-catalog-search" action="/search/" method="get">
              <label for="mobile-archive-catalog-search">Search the record</label>
              <div class="mobile-catalog-search__row">
                <input
                  id="mobile-archive-catalog-search"
                  name="q"
                  type="search"
                  autocomplete="off"
                  placeholder="Rome, stewardship, competition…"
                />
                <button type="submit">Search</button>
              </div>
            </form>

            <section class="mobile-catalog-section" aria-labelledby="mobile-archive-years-heading">
              <div class="mobile-catalog-section__heading">
                <h3 id="mobile-archive-years-heading">By Year</h3>
                <a href="/observations/archive/">Complete chronology</a>
              </div>
              {years.length > 0 ? (
                <ul class="mobile-catalog-link-list">
                  {years.map((item) => (
                    <li>
                      <a href={`/observations/archive/#year-${item.year}`}>
                        <span>{item.year}</span>
                        <small>{item.count} {item.count === 1 ? 'work' : 'works'}</small>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mobile-catalog-empty">Published years will appear here.</p>
              )}
            </section>

            <section class="mobile-catalog-section" aria-labelledby="mobile-archive-topics-heading">
              <div class="mobile-catalog-section__heading">
                <h3 id="mobile-archive-topics-heading">By Topic</h3>
                <a href="/topics/">All topics</a>
              </div>
              {topics.length > 0 ? (
                <ul class="mobile-catalog-link-list">
                  {topics.map((topic) => (
                    <li>
                      <a href={`/topics/${topic.slug}/`}>
                        <span>{topic.label}</span>
                        <small>{topic.count}</small>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mobile-catalog-empty">Published topics will appear here.</p>
              )}
            </section>

            <nav class="mobile-catalog-panel__destinations" aria-label="Archive destinations">
              <a href="/observations/archive/">
                <span>Observation Archive</span>
                <small>Every published observation</small>
              </a>
              <a href="/special-editions/">
                <span>Collections</span>
                <small>Special editions and permanent works</small>
              </a>
              <a href="/works/">
                <span>Works Room</span>
                <small>Return to current work</small>
              </a>
            </nav>
          </div>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-mobile-archive-overlay]').forEach((overlay) => {
    const trigger = overlay.querySelector('[data-mobile-catalog-trigger]');
    const panel = overlay.querySelector('[data-mobile-catalog-panel]');
    const closeButton = overlay.querySelector('[data-mobile-catalog-close]');

    if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const openPanel = () => {
      trigger.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      panel.dataset.open = 'true';
    };

    const closePanel = ({ returnFocus = false } = {}) => {
      trigger.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      delete panel.dataset.open;
      if (returnFocus) trigger.focus();
    };

    trigger.addEventListener('click', () => {
      if (trigger.getAttribute('aria-expanded') === 'true') closePanel();
      else openPanel();
    });

    closeButton?.addEventListener('click', () => closePanel({ returnFocus: true }));

    document.addEventListener('pointerdown', (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (panel.dataset.open === 'true' && !panel.contains(target) && !trigger.contains(target)) closePanel();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.dataset.open === 'true') closePanel({ returnFocus: true });
    });
  });
</script>

<style>
  .mobile-archive-room {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #17120d;
  }

  .mobile-archive-room__scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #17120d;
  }

  /*
   * Locked mobile plate: 840 × 1872.
   * At 390 × 824 this preserves the full width and crops only a small amount
   * vertically, maintaining the plate/hotspot coordinate system.
   */
  .mobile-archive-room__canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    height: max(100svh, 222.857vw);
    aspect-ratio: 840 / 1872;
    transform: translate(-50%, -50%);
    isolation: isolate;
  }

  .mobile-archive-room__plate {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .mobile-archive-room__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .mobile-archive-hit {
    --halo: rgb(211 166 92 / 30%);
    --halo-strong: rgb(231 190 119 / 96%);
    position: absolute;
    pointer-events: auto;
    display: block;
    padding: 0;
    color: rgb(249 238 217 / 98%);
    border: 1.5px solid var(--halo);
    border-radius: 0.28rem;
    background: rgb(29 20 12 / 2%);
    box-shadow: inset 0 0 1rem rgb(255 226 170 / 2%);
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  button.mobile-archive-hit {
    font: inherit;
  }

  .mobile-archive-hit:focus-visible,
  .mobile-archive-hit[aria-expanded='true'] {
    outline: 2px solid rgb(244 211 153 / 96%);
    outline-offset: 3px;
    border-color: var(--halo-strong);
    background: rgb(255 231 183 / 8%);
  }

  .mobile-archive-hit__label {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 58%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.55rem;
    width: max-content;
    max-width: 9.5rem;
    padding: 0.24rem 0.48rem 0.27rem;
    color: rgb(249 238 217 / 98%);
    background: rgb(30 20 12 / 92%);
    border: 1px solid rgb(207 163 92 / 72%);
    border-radius: 0.14rem;
    box-shadow: 0 0.25rem 0.75rem rgb(10 6 3 / 32%);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1.1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Mobile hotspot map on the locked portrait plate. */
  .mobile-archive-hit--catalog {
    left: 23%;
    top: 38.2%;
    width: 54%;
    height: 21.5%;
    border-width: 2px;
  }

  .mobile-archive-hit--catalog .mobile-archive-hit__label {
    font-size: 0.61rem;
    padding-inline: 0.62rem;
  }

  .mobile-archive-hit--observation {
    left: 27%;
    top: 58.5%;
    width: 46%;
    height: 17.5%;
  }

  .mobile-archive-hit--collections {
    left: 4.5%;
    top: 27%;
    width: 16.5%;
    height: 37%;
  }

  .mobile-archive-hit--works {
    left: 79%;
    top: 27%;
    width: 16.5%;
    height: 37%;
  }

  .mobile-archive-hit--collections .mobile-archive-hit__label,
  .mobile-archive-hit--works .mobile-archive-hit__label {
    bottom: 5%;
  }

  .mobile-catalog-panel {
    position: fixed;
    z-index: 100;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 1rem);
    width: 100vw;
    max-height: 86svh;
    overflow: auto;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    color: rgb(245 235 216);
    background: linear-gradient(rgb(33 24 16 / 96%), rgb(22 16 11 / 97%)), rgb(24 17 11);
    border-top: 1px solid rgb(199 151 79 / 66%);
    box-shadow: 0 -1rem 3rem rgb(7 4 2 / 42%);
    transition: opacity 170ms ease, transform 170ms ease, visibility 170ms ease;
  }

  .mobile-catalog-panel[data-open='true'] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .mobile-catalog-panel__header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem;
    background: rgb(29 21 14 / 97%);
    border-bottom: 1px solid rgb(199 151 79 / 32%);
  }

  .mobile-catalog-panel__eyebrow {
    margin: 0 0 0.3rem;
    color: rgb(211 168 103 / 95%);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-catalog-panel h2 {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .mobile-catalog-panel__close {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: rgb(245 235 216);
    background: transparent;
    border: 1px solid rgb(199 151 79 / 45%);
    border-radius: 50%;
    font: inherit;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .mobile-catalog-panel__body {
    display: grid;
    gap: 0.75rem;
    padding: 0.8rem;
  }

  .mobile-catalog-search,
  .mobile-catalog-section {
    padding: 0.75rem;
    background: rgb(255 239 207 / 3.5%);
    border: 1px solid rgb(199 151 79 / 28%);
  }

  .mobile-catalog-search label {
    display: block;
    margin-bottom: 0.45rem;
    color: rgb(211 168 103 / 95%);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .mobile-catalog-search__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
  }

  .mobile-catalog-search input {
    min-width: 0;
    width: 100%;
    padding: 0.58rem 0.7rem;
    color: inherit;
    background: rgb(9 6 4 / 24%);
    border: 1px solid rgb(199 151 79 / 38%);
    border-radius: 0.16rem;
    font: inherit;
  }

  .mobile-catalog-search button {
    padding: 0.58rem 0.85rem;
    color: rgb(36 24 13);
    background: rgb(218 174 102);
    border: 1px solid rgb(239 206 151 / 85%);
    border-radius: 0.16rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-catalog-section__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgb(199 151 79 / 22%);
  }

  .mobile-catalog-section h3 {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .mobile-catalog-section__heading a {
    color: rgb(211 168 103);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-catalog-link-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .mobile-catalog-link-list a,
  .mobile-catalog-panel__destinations a {
    display: flex;
    color: inherit;
    text-decoration: none;
    background: rgb(255 239 207 / 2.5%);
    border: 1px solid rgb(199 151 79 / 20%);
  }

  .mobile-catalog-link-list a {
    align-items: baseline;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.5rem 0.6rem;
  }

  .mobile-catalog-link-list small,
  .mobile-catalog-panel__destinations small {
    color: rgb(195 177 148);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.64rem;
  }

  .mobile-catalog-panel__destinations {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .mobile-catalog-panel__destinations a {
    align-items: flex-start;
    flex-direction: column;
    min-height: 3.8rem;
    padding: 0.65rem 0.75rem;
  }

  .mobile-catalog-panel__destinations span {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-catalog-panel {
      transition: none;
    }
  }
</style>
