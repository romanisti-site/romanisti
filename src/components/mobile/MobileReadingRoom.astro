---
import { getCollection } from 'astro:content';
import { observationSlug } from '@/lib/url';
import plate from '@/assets/reading-room/mobile/reading-room-mobile-plate-v1.webp';

const entries = await getCollection('observations');

const observations = entries
  .filter((entry) => entry.data.status === 'published')
  .map((entry) => ({
    title: entry.data.title,
    href: `/observations/${observationSlug(entry.id)}/`,
    published: entry.data.publishedAt,
  }))
  .sort((a, b) => b.published.getTime() - a.published.getTime())
  .slice(0, 5);

/*
 * RC1.2 canonical mobile geometry measured against the locked 941 × 1672 plate.
 * These are live HTML overlays; the five foreground Liberi remain blank in the image.
 */
const libri = [
  { left: '5.8%',  top: '70.0%', width: '13.5%', height: '15.0%' },
  { left: '23.9%', top: '70.0%', width: '14.5%', height: '15.0%' },
  { left: '42.2%', top: '70.0%', width: '14.2%', height: '15.0%' },
  { left: '60.3%', top: '70.0%', width: '14.3%', height: '15.0%' },
  { left: '78.5%', top: '70.0%', width: '14.2%', height: '15.0%' },
];
---

<section class="mobile-room mobile-reading-room" aria-label="The Reading Room">
  <img
    class="mobile-room__plate mobile-reading-room__plate"
    src={plate.src}
    width={plate.width}
    height={plate.height}
    alt="The Reading Room, with five blank stone Liberi in the foreground."
    loading="eager"
    decoding="async"
  />

  <ol class="mobile-reading-room__libri" aria-label="Five most recent observations">
    {observations.map((observation, index) => {
      const liber = libri[index];
      return (
        <li style={`--left-num:${parseFloat(liber.left)};--top-num:${parseFloat(liber.top)};--width-num:${parseFloat(liber.width)};--height-num:${parseFloat(liber.height)};`}>
          <a href={observation.href} aria-label={`Read ${observation.title}`}>
            <span class="mobile-reading-room__category">Observation</span>
            <span class="mobile-reading-room__title">{observation.title}</span>
          </a>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .mobile-reading-room {
    height: 100svh;
    min-height: 100svh;
    background: #120d09;
  }

  @supports (height: 100dvh) {
    .mobile-reading-room {
      height: 100dvh;
      min-height: 100dvh;
    }
  }

  .mobile-reading-room__plate {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
    background: #120d09;
  }

  .mobile-reading-room__libri {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .mobile-reading-room__libri li {
    position: absolute;
    /*
     * Reproject source-image percentages through the same centered `cover`
     * transform used by the locked 941 × 1672 mobile plate.
     * Source aspect ratio: 941 / 1672 = 0.5627990.
     */
    --cover-width: max(100vw, calc(100svh * 0.5627990));
    --cover-height: max(100svh, calc(100vw / 0.5627990));
    left: calc(50% + (var(--left-num) - 50) * var(--cover-width) / 100);
    top: calc(50% + (var(--top-num) - 50) * var(--cover-height) / 100);
    width: calc(var(--width-num) * var(--cover-width) / 100);
    height: calc(var(--height-num) * var(--cover-height) / 100);
  }

  @supports (height: 100dvh) {
    .mobile-reading-room__libri li {
      --cover-width: max(100vw, calc(100dvh * 0.5627990));
      --cover-height: max(100dvh, calc(100vw / 0.5627990));
    }
  }

  /*
   * RC2.13 — Canonical mobile Liber overlay geometry.
   *
   * Liber I was the measured/verified working overlay on the locked 941 × 1988
   * mobile plate. That geometry is now the template for every foreground Liber.
   * The horizontal spacing from RC2.6 is preserved; only the proven Liber I
   * calibration is replicated across the row.
   *
   * IMPORTANT: future Observation tiles inherit these same coordinates. Do not
   * special-case a newly published work by index.
   */
  .mobile-reading-room__libri li {
    top: 75.61% !important;
    width: 18.82% !important;
    height: 13.47% !important;
  }

  .mobile-reading-room__libri li:nth-child(1) { left: 2.44% !important; }
  .mobile-reading-room__libri li:nth-child(2) { left: 21.54% !important; }
  .mobile-reading-room__libri li:nth-child(3) { left: 40.64% !important; }
  .mobile-reading-room__libri li:nth-child(4) { left: 59.74% !important; }
  .mobile-reading-room__libri li:nth-child(5) { left: 78.84% !important; }



  .mobile-reading-room__libri a {
    pointer-events: auto;
    position: absolute;
    inset: 0;
    display: block;
    box-sizing: border-box;
    color: rgb(38 27 19);
    text-align: center;
    text-decoration: none;
    text-shadow: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-reading-room__category {
    position: absolute;
    top: 7.2%;
    left: 7%;
    width: 86%;
    margin: 0;
    color: rgb(38 27 19);
    font-family: var(--font-sans, Arial, sans-serif);
    font-size: clamp(0.38rem, 1.50vw, 0.50rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    text-align: left;
    text-transform: uppercase;
  }

  /*
   * RC2.13 — Romanisti Mobile Liber category standard.
   * Every mobile Liber uses the locked three-letter category abbreviation.
   * Observation => OBS. The position is the proven Liber I position and is
   * identical on every tile.
   */
  .mobile-reading-room__category {
    left: 21%;
    width: 72%;
    font-size: 0;
    text-align: left;
  }

  .mobile-reading-room__category::after {
    content: "OBS";
    display: block;
    color: rgb(38 27 19);
    font-family: var(--font-sans, Arial, sans-serif);
    font-size: clamp(0.38rem, 1.50vw, 0.50rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
    text-align: left;
  }


  .mobile-reading-room__title {
    position: absolute;
    top: 24.3%;
    left: 14%;
    width: 72%;
    margin: 0;
    color: rgb(38 27 19);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(0.49rem, 1.95vw, 0.64rem);
    font-weight: 700;
    line-height: 1.03;
    text-align: center;
    text-wrap: balance;
    transform: translateY(3px);
  }

  .mobile-reading-room__date {
    position: absolute;
    top: 74.8%;
    left: 7%;
    width: 86%;
    margin: 0;
    color: rgb(38 27 19);
    font-family: var(--font-sans, Arial, sans-serif);
    font-size: clamp(0.30rem, 1.16vw, 0.39rem);
    font-weight: 600;
    line-height: 1;
    text-align: center;
  }

  .mobile-reading-room__libri li:first-child .mobile-reading-room__date {
    display: none;
  }


  /* Titles always render from live Observation content; no index-specific text. */

  .mobile-reading-room__libri a:focus-visible {
    outline: 1px solid rgb(103 74 44 / 70%);
    outline-offset: -3px;
  }

  @media (min-width: 52.001rem) {
    .mobile-reading-room { display: none; }
  }
</style>
