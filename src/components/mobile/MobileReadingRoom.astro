---
import { getCollection } from 'astro:content';
import { observationSlug } from '@/lib/url';
import plate from '@/assets/reading-room/mobile/reading-room-mobile-plate-v1.webp';

const entries = await getCollection('observations');

const observations = entries
  .filter((entry) => entry.data.status === 'published')
  .map((entry) => ({
    title: entry.data.title,
    href: `/observations/${observationSlug(entry.id)}/`,
    published: entry.data.publishedAt,
  }))
  .sort((a, b) => b.published.getTime() - a.published.getTime())
  .slice(0, 5);

/*
 * RC1.2 canonical mobile geometry measured against the locked 941 × 1672 plate.
 * These are live HTML overlays; the five foreground Liberi remain blank in the image.
 */
const libri = [
  { left: '5.8%',  top: '70.0%', width: '13.5%', height: '15.0%' },
  { left: '23.9%', top: '70.0%', width: '14.5%', height: '15.0%' },
  { left: '42.2%', top: '70.0%', width: '14.2%', height: '15.0%' },
  { left: '60.3%', top: '70.0%', width: '14.3%', height: '15.0%' },
  { left: '78.5%', top: '70.0%', width: '14.2%', height: '15.0%' },
];
---

<section class="mobile-room mobile-reading-room" aria-label="The Reading Room">
  <img
    class="mobile-room__plate mobile-reading-room__plate"
    src={plate.src}
    width={plate.width}
    height={plate.height}
    alt="The Reading Room, with five blank stone Liberi in the foreground."
    loading="eager"
    decoding="async"
  />

  <ol class="mobile-reading-room__libri" aria-label="Five most recent observations">
    {observations.map((observation, index) => {
      const liber = libri[index];
      return (
        <li style={`--left-num:${parseFloat(liber.left)};--top-num:${parseFloat(liber.top)};--width-num:${parseFloat(liber.width)};--height-num:${parseFloat(liber.height)};`}>
          <a href={observation.href} aria-label={`Read ${observation.title}`}>
            <span class="mobile-reading-room__category">Observation</span>
            <span class="mobile-reading-room__title">{observation.title}</span>
          </a>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .mobile-reading-room {
    height: 100svh;
    min-height: 100svh;
    background: #120d09;
  }

  @supports (height: 100dvh) {
    .mobile-reading-room {
      height: 100dvh;
      min-height: 100dvh;
    }
  }

  .mobile-reading-room__plate {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
    background: #120d09;
  }

  .mobile-reading-room__libri {
    position: absolute;
    inset: 0;
    z-index: 2;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .mobile-reading-room__libri li {
    position: absolute;
    /*
     * Reproject source-image percentages through the same centered `cover`
     * transform used by the locked 941 × 1672 mobile plate.
     * Source aspect ratio: 941 / 1672 = 0.5627990.
     */
    --cover-width: max(100vw, calc(100svh * 0.5627990));
    --cover-height: max(100svh, calc(100vw / 0.5627990));
    left: calc(50% + (var(--left-num) - 50) * var(--cover-width) / 100);
    top: calc(50% + (var(--top-num) - 50) * var(--cover-height) / 100);
    width: calc(var(--width-num) * var(--cover-width) / 100);
    height: calc(var(--height-num) * var(--cover-height) / 100);
  }

  @supports (height: 100dvh) {
    .mobile-reading-room__libri li {
      --cover-width: max(100vw, calc(100dvh * 0.5627990));
      --cover-height: max(100dvh, calc(100vw / 0.5627990));
    }
  }

  /*
   * RC2.6 mobile-only Liber overlay positioning.
   *
   * The portrait plate is already the locked mobile composition.  Do not
   * project the five live Liber inscriptions from the uncropped source-image
   * width: at narrow viewports that pushes the first inscription into the
   * cropped left margin.  Instead anchor each inscription directly to the
   * visible portrait composition.
   *
   * These percentages are viewport-relative and affect ONLY the live overlay
   * surfaces; the architectural image, crop and links remain unchanged.
   */
  .mobile-reading-room__libri li {
    top: 80.25% !important;
    height: 8.15% !important;
    width: 18.25% !important;
  }

  .mobile-reading-room__libri li:nth-child(1) { left: 3.25% !important; }
  .mobile-reading-room__libri li:nth-child(2) { left: 22.35% !important; }
  .mobile-reading-room__libri li:nth-child(3) { left: 41.45% !important; }
  .mobile-reading-room__libri li:nth-child(4) { left: 60.55% !important; }
  .mobile-reading-room__libri li:nth-child(5) { left: 79.65% !important; }


  .mobile-reading-room__libri a {
    pointer-events: auto;
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 0;
    color: rgb(69 48 31 / 94%);
    text-align: center;
    text-decoration: none;
    text-shadow: 0 1px 0 rgb(255 255 255 / 38%);
    -webkit-tap-highlight-color: transparent;
  }

  /*
   * RC2.9 — exact inscription placement inside the already-correct RC2.6
   * Liber geometry.  The category and title are independently positioned
   * against the visible stone face instead of being vertically centered as
   * one flex group.
   */
  .mobile-reading-room__category {
    position: absolute;
    top: 3%;
    left: 7%;
    width: 86%;
    margin: 0;
    font-family: var(--font-sans, Arial, sans-serif);
    font-size: clamp(0.34rem, 1.38vw, 0.47rem);
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  .mobile-reading-room__title {
    position: absolute;
    top: 29%;
    left: 6%;
    width: 88%;
    margin: 0;
    overflow: visible;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(0.44rem, 1.78vw, 0.60rem);
    font-weight: 600;
    line-height: 1.04;
    text-align: center;
  }

  /*
   * Liber I has a deliberately composed three-line title in both languages.
   * Keep the original text node in place for accessibility; hide it visually
   * and draw only the controlled three-line inscription.
   */
  .mobile-reading-room__libri li:first-child .mobile-reading-room__title {
    font-size: 0 !important;
    line-height: 1;
  }

  .mobile-reading-room__libri li:first-child .mobile-reading-room__title::after {
    content: "An Institution\A Begins by\A Observing";
    display: block;
    white-space: pre-line;
    color: rgb(69 48 31 / 94%);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(0.44rem, 1.78vw, 0.60rem);
    font-weight: 600;
    line-height: 1.04;
    text-align: center;
    text-shadow: 0 1px 0 rgb(255 255 255 / 38%);
  }

  html[lang="it"] .mobile-reading-room__libri li:first-child .mobile-reading-room__title::after {
    content: "Un’Istituzione\A Comincia\A Osservando";
  }


  .mobile-reading-room__libri a:focus-visible {
    outline: 1px solid rgb(103 74 44 / 70%);
    outline-offset: -3px;
  }

  @media (min-width: 52.001rem) {
    .mobile-reading-room { display: none; }
  }
</style>
