---
import plate from '../../assets/governance-room/governance-room-architectural-plate-rc1.png';
---

<div class="governance-room-plate" aria-hidden="true">
  <img
    src={plate.src}
    width={plate.width}
    height={plate.height}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="governance-room-plate__depth"></div>
</div>

<style>
  .governance-room-plate {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #21170f;
  }

  .governance-room-plate img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .governance-room-plate__depth {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow:
      inset 0 0 6.5rem rgb(13 9 5 / 8%),
      inset 0 -2.5rem 5rem rgb(13 9 5 / 6%);
  }
</style>
