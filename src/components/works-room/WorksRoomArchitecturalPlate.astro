---
import plate from '../../assets/works-room/works-room-architectural-plate-v1.png';
---

<div class="works-room-plate" aria-hidden="true">
  <img
    src={plate.src}
    width={plate.width}
    height={plate.height}
    alt=""
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="works-room-plate__depth"></div>
</div>

<style>
  .works-room-plate {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #332519;
  }

  .works-room-plate img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .works-room-plate__depth {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow:
      inset 0 0 7rem rgb(15 10 7 / 11%),
      inset 0 -3rem 6rem rgb(15 10 7 / 7%);
  }
</style>
