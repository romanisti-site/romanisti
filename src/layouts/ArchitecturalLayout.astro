---
import Seo from '@/components/Seo.astro';
import StructuredData from '@/components/StructuredData.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import LanguageLayer from '@/components/i18n/LanguageLayer.astro';
import ArchitecturalHeader from '@/components/ArchitecturalHeader.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
}

const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Romanisti" href="/rss.xml" />
    <Seo {...props} />
    <StructuredData
      kind={props.type ?? 'website'}
      title={props.title}
      description={props.description}
      publishedAt={props.publishedAt}
      updatedAt={props.updatedAt}
      author={props.author}
    />
  </head>
  <body class="architectural-page">
    <LanguageLayer />
    <ReadingProgress />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <ArchitecturalHeader />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.architectural-page {
    margin: 0;
    background: #17120d;
  }

  body.architectural-page > main {
    margin: 0;
    padding: 0;
  }
</style>
